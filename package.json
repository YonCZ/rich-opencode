{
  "name": "rich-opencode",
  "version": "1.0.0",
  "description": "Highly configurable Discord Rich Presence plugin for OpenCode — your model, context usage, activity status and a play-session timer, arranged how you want.",
  "type": "module",
  "license": "MIT",
  "author": "YonCZ",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "discord",
    "discord-rpc",
    "rich-presence",
    "presence",
    "plugin"
  ],
  "homepage": "https://github.com/YonCZ/rich-opencode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YonCZ/rich-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/YonCZ/rich-opencode/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "oc-plugin": [
    "server"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "preview": "node preview.mjs",
    "diagnose": "node diagnose.mjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@opencode/plugin": "^2.0.14",
    "@types/node": "^25.8.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29",
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  }
}
