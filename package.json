{
  "name": "opencode-rpc",
  "version": "1.2.4",
  "description": "Discord Rich Presence plugin for OpenCode",
  "type": "module",
  "license": "MIT",
  "author": "butterbrodskiy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterbrodskiy/opencode-rpc.git"
  },
  "homepage": "https://github.com/butterbrodskiy/opencode-rpc#readme",
  "bugs": {
    "url": "https://github.com/butterbrodskiy/opencode-rpc/issues"
  },
  "keywords": [
    "opencode",
    "discord",
    "rich-presence",
    "discord-rpc",
    "rpc",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.1",
    "opencode-rpc": "^1.2.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.8",
    "@opencode-ai/sdk": "^1.4.8",
    "@types/node": "^25.8.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  }
}
