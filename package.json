{
  "name": "opencode-rpc",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "author": "butterbrodskiy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterbrodskiy/opencode-rpc.git"
  },
  "homepage": "https://github.com/butterbrodskiy/opencode-rpc#readme",
  "bugs": {
    "url": "https://github.com/butterbrodskiy/opencode-rpc/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "discord",
    "discord-rpc",
    "rich-presence",
    "presence",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "oc-plugin": [
    "server"
  ],
  "files": [
    "dist",
    "scripts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@opencode-ai/sdk": "^1.18.32",
    "@opencode/plugin": "^2.0.14",
    "@types/node": "^25.8.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.29",
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  }
}
